		<property name ="driverClassName" value="com.mysql.jdbc.Driver" /> 
		<property name ="url" value="jdbc:mysql://localhost:3306/ganesh" /> 
		<property name ="username" value="root" /> 
		<property name ="password" value="Ganesh8Scorpio_" /> 
	</bean> 



	<bean class="org.springframework.jdbc.core.JdbcTemplate" name ="jdbcTemplate"> 
		<property name="dataSource">  <ref bean ="ds" /> </property> 
	</bean> 
	
	<context:component-scan base-package="tech.suj.Controller"></context:component-scan>

</beans>


 



	
	
	
	
	
	

